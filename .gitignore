# ----------------- DATA FILES - NEW - explicit ignore
# Strategia: ignora SOLO i tipi di file pesanti, lascia tracciare tutto
# il resto (md, pdf, png, R, .gitkeep). Evita il problema "parent dir excluded → eccezioni non funzionano".
#
# Se in futuro arriva un nuovo formato pesante (es. .parquet, .h5), aggiungilo qui.
# [PRIMA] touch data_in/.gitkeep data_out/.gitkeep

# ----- INPUT data: ignore heavy file types
data_in/**/*.xlsx
data_in/**/*.xls
data_in/**/*.rds
data_in/**/*.csv
data_in/**/*.tsv
data_in/**/*.zip

# ----- OUTPUT data: ignore heavy file types
data_out/**/*.xlsx
data_out/**/*.xls
data_out/**/*.rds
data_out/**/*.csv
data_out/**/*.docx
data_out/**/*.zip




#####    # ----------------- DATA FILES - WRONG - implicit keep
#####
#####    # ----- INPUT data
#####    # Ignore everything under data_in/ bc may be very BIG ...
#####    data_in/**/*
#####    # ...BUT keep:
#####    !data_in/**/*.md
#####    !data_in/**/*.pdf
#####    !data_in/**/*.png
#####    # lookup tables (codice, single source of truth)
#####    !data_in/lookup/**/*.R
#####
#####    # ----- OUTPUT data
#####    # Ignore everything under data_out/ bc may be very BIG ...
#####    data_out/**/*
#####    # ...BUT keep:
#####    !data_out/**/*.md
#####    !data_out/**/*.pdf
#####
#####    # ----- Placeholder per struttura cartelle (in qualunque punto)
#####    # [PRIMA] touch data_in/.gitkeep data_out/.gitkeep
#####    !**/.gitkeep

**/*.quarto_ipynb
